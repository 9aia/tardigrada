{
  "name": "tardigrada-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "bun run docs:gen && vitepress dev",
    "docs:gen": "bun run docs:cli",
    "docs:check": "bun run docs:gen && git diff --exit-code",
    "docs:cli": "cypera gen cli --repo ..",
    "docs:build": "bun run docs:gen && vitepress build",
    "docs:deploy": "bun run docs:build && bunx gh-pages -d .vitepress/dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vitepress": "^1.6.3",
    "vitepress-theme-9aia": "github:9aia/vitepress-theme-9aia#c27ab447f9467f1127473a2256e0a71b76a86bf7"
  }
}
